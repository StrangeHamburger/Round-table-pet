{
  "name": "round-table-pet",
  "version": "1.0.0",
  "description": "Windows 桌面宠物「团团」：会呼吸、会互动、跟着音乐摆动的大圆球",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.roundtablepet.app",
    "productName": "团团桌面宠物",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "music.ps1",
        "to": "music.ps1"
      },
      {
        "from": "keyboard.ps1",
        "to": "keyboard.ps1"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "团团桌面宠物"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}